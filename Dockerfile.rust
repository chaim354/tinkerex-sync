# syntax=docker/dockerfile:1
# check=error=true

# THE SYNC SERVER AS ONE STATIC-ISH BINARY (crates/tinkerex-sync) -- the repository's only image
# since Phase 6 of docs/superpowers/plans/2026-09-30-rust-rewrite.md deleted the Ruby host and its
# ./Dockerfile. Built and pushed with `bin/build-and-push`.
#
# SAME PATHS, PORT AND ENV NAMES AS THE RUBY IMAGE IT REPLACED, on purpose (plan D2): the maker
# repo's `sync` accessory block in config/deploy.yml changed by zero lines at the cutover, and the
# rollback image (ruby-<R>) can still boot on what this one writes. /rails/host -- the Rails app's
# directory in that image -- is still the working directory, and /rails/host/storage still holds
# the SQLite file and, with STORAGE_BACKEND=local, every chunk byte: the volume declared there
# mounts over it unchanged. uid 1000, so a volume the Ruby container populated is writable here too.

# Same toolchain as rust-toolchain.toml, which pins every cargo run in this checkout (CI's
# rust-check included) but is not copied in here -- so this tag is the image's pin, not a floating
# `rust:1`. Bump the two together.
FROM docker.io/library/rust:1.99.0-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release --locked -p tinkerex-sync && \
    strip target/release/tinkerex-sync

FROM docker.io/library/debian:bookworm-slim

# curl: bin/restore-db in the maker repo execs it inside the container to probe /up.
# ca-certificates: STORAGE_BACKEND=s3 presigns against an HTTPS endpoint.
# sqlite3: THE MAKER REPO'S BACKUP AND RESTORE RUN IT INSIDE THIS IMAGE, not on the box. Its
#   ops/backup-db.sh runs its worker as `docker run --rm --user 0 -v "$src:/src" "$image" sh -c
#   "$WORKER"` where `$image` is the running tinkerex-sync container's image, and the worker calls
#   `sqlite3 .backup` and `PRAGMA integrity_check`; bin/restore-db's `--into` verify does the same,
#   and a real restore runs bin/backup-db first, so it needs it too. Without this line the nightly
#   `sync` archive fails from the first night after the cutover -- loudly (`!! sync: FAILED`, exit 1,
#   Kuma `down`), but with nothing to restore from until someone reads it -- and `bin/restore-db
#   sync` cannot run (docs/superpowers/plans/2026-10-07-rust-cutover.md §0.3.1). The Ruby image
#   installed it for the same reason.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y ca-certificates curl sqlite3 && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash

COPY --from=build /src/target/release/tinkerex-sync /usr/local/bin/tinkerex-sync
COPY bin/docker-entrypoint-rust /usr/local/bin/docker-entrypoint

# STORAGE HOLDS THE DATABASE AND, WITH STORAGE_BACKEND=local, THE CHUNKS THEMSELVES. It must be a
# VOLUME in any real deployment: losing it loses the library, not a cache.
RUN mkdir -p /rails/host/storage /rails/host/tmp && chown -R rails:rails /rails

USER 1000:1000
WORKDIR /rails/host

# The defaults the Ruby host's config resolved to; the accessory's env overrides any of them.
ENV SQLITE_DATABASE=/rails/host/storage/production.sqlite3 \
    CHUNK_LOCAL_DIR=/rails/host/storage/chunk-store \
    BIND=0.0.0.0 \
    PORT=3000

# `migrate` RUNS IN THE ENTRYPOINT FOR THE SERVER ONLY, so `docker exec ... tinkerex-sync stats`
# and one-off `gc` runs never migrate as a side effect -- the same guard the Ruby image's entrypoint
# kept around db:prepare.
ENTRYPOINT ["docker-entrypoint"]

EXPOSE 3000
CMD ["tinkerex-sync", "serve"]
