# Standard dummy-app Rakefile -- and NOT decoration: `bin/rails db:create`/`db:migrate` invoke a
# real `Rake::Application#run` under the hood, which searches UPWARD from Dir.pwd for a literal
# `Rakefile` unless one already exists at the current directory. Without this file, that search
# walked straight past test/dummy and found engines/tinkerex-sync/Rakefile instead -- which only
# defines :test -- so `bin/rails db:create` inside test/dummy failed with "Unrecognized command"
# (verified: reproduced before this file existed, gone after). This file gives the search
# somewhere to stop, exactly as `Rails.application.load_tasks` pulls in Active Record's real
# db:* namespace (from active_record/railtie.rb's own `rake_tasks do` block) the normal way any
# Rails app does.
require_relative "config/application"

Rails.application.load_tasks
