#!/bin/bash -e

# PREPARES THE DATABASE BEFORE THE SERVER STARTS, and this app shipped without it.
#
# The first real deployment came up "healthy" -- /up 200 on both proxy hostnames -- with an EMPTY
# database, and the failure only surfaced when something touched a table:
# `Could not find table 'users'`. Nothing about the deploy reported a problem, because nothing in
# the boot path or the healthcheck reads the schema.
#
# Same shape and same fix as chaim354/tinkerex's own entrypoint: run db:prepare only when the
# command really is the server, so `kamal app exec` and one-off rake tasks are not made to migrate
# as a side effect of running.
if [ "${1}" == "bin/rails" ] && [ "${2}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
