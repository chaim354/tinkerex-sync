#!/usr/bin/env bash
# Build + push this repo's image (./Dockerfile.rust, the Rust server -- the only implementation since
# Phase 6 of docs/superpowers/plans/2026-09-30-rust-rewrite.md deleted the Ruby) to ghcr, under a
# STABLE tag that exists independently of any `kamal deploy`.
#
# THAT DISTINCTION IS THE WHOLE REASON THIS SCRIPT EXISTS. A Kamal ACCESSORY -- which is how the
# maker app, chaim354/tinkerex, runs this image, beside its own three LIBRARY_BACKEND deployments --
# never builds anything: `kamal accessory boot/reboot` only PULLS a named image, the same way it does
# for the boxes/openscad sidecars and the addons bundle host. Nothing else produces the tag that pull
# needs. (This repo once carried its own config/deploy.yml for a standalone kamal SERVICE, which
# tagged by kamal's per-deploy version and never `:latest`; it deployed the Ruby host and left with
# it in Phase 6.)
#
# Mirrors chaim354/tinkerex's bin/build-boxes-sidecar / bin/build-openscad-sidecar: same registry,
# same 1Password item, same revision label. The TAGS differ -- the revision tag carries the
# implementation suffix and `:latest` is optional (the tagging comment below). Run from THIS repo's
# root, same as those two.
#
# The ghcr token comes from 1Password via bin/secret -- no export needed. Export
# KAMAL_REGISTRY_PASSWORD first if you want to override it. `set -e` aborts here if the read fails
# (unlike kamal itself, whose backticks discard exit status -- see the maker app's
# bin/secrets-preflight and its CLAUDE.md §14g).
#
# The maker app's config/deploy.yml runs this image as its `sync` accessory, pulling `:latest`; the
# roll command from THAT repo is `bin/kamal accessory reboot sync`. Which is why `:latest` is the
# one tag this script must be able to leave alone (SYNC_PUSH_LATEST=0, below).
set -euo pipefail

KAMAL_REGISTRY_PASSWORD="$(bin/secret KAMAL_REGISTRY_PASSWORD 'op://tinkerex/ghcr.io/password')"
REPO="ghcr.io/chaim354/tinkerex-sync"
IMAGE="$REPO:latest"
DOCKERFILE=Dockerfile.rust

# PROVENANCE -- the source commit rides inside the image as an OCI label, so a container already
# running can name the build it came from with no registry access and no tag enumeration:
#
#   docker inspect <container> --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# A SHA TAG ALONE CANNOT ANSWER THAT (full argument in bin/build-boxes-sidecar over in the maker
# repo): the OCI distribution API has no digest->tag reverse lookup, and `kamal accessory details`
# shells out to `docker ps`, which prints the RUN REFERENCE -- `:latest` -- never a digest. The
# label rides inside the image itself, so it survives tag GC or a moved `:latest`; the
# `$REVISION-rust` tag below is registry inventory alongside it, not a substitute for it.
#
# DO NOT SPELL THIS `git describe --dirty`. `--dirty` only consults TRACKED files, and
# Dockerfile.rust COPYs crates/ from the working tree (build context = repo root), so an untracked
# source file there would build into the image while `--dirty` kept reporting a clean SHA.
# `git status --porcelain` lists untracked files too, so it is what decides -- same fix, same
# reasoning, as both sidecar scripts. (So keep git worktrees OUTSIDE this checkout before running
# this: one placed under it once made a revision `-dirty`, cutover plan §0.5.)
REVISION="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain)" ]; then
  REVISION="$REVISION-dirty"
fi

# ONE IMPLEMENTATION. SYNC_IMPL chose between ./Dockerfile (the Ruby host) and ./Dockerfile.rust
# until Phase 6 deleted the Ruby; there is nothing left to choose. `SYNC_IMPL=rust` -- the
# cutover-era spelling in the plans and READMEs -- still works. Anything else is REFUSED, not
# ignored, because the one other value anyone would type is `ruby`, from the cutover plan's
# rollback notes, and ignoring it would build the Rust image and move `:latest` while the operator
# believed they had rebuilt the rollback. A rollback needs no build: it is a retag of the pinned
# Ruby image, ruby-<R> (docs/superpowers/plans/2026-10-07-rust-cutover.md §6).
case "${SYNC_IMPL:-rust}" in
  rust) ;;
  *)
    echo "SYNC_IMPL='${SYNC_IMPL}': this script builds only the Rust server since Phase 6 deleted the Ruby." >&2
    echo "To roll back, retag the pinned Ruby image instead (cutover plan §6):" >&2
    echo "  docker buildx imagetools create -t $IMAGE $REPO:ruby-<R>" >&2
    exit 2
    ;;
esac

# `:latest` IS PUSHED ONLY WHEN SYNC_PUSH_LATEST IS 1 (unset = 1). Exactly `0` or `1`: anything else
# is refused rather than read as "yes", because a typo such as `SYNC_PUSH_LATEST=no` would otherwise
# move `:latest` -- the dangerous direction (the tagging comment below says why it is dangerous).
PUSH_LATEST="${SYNC_PUSH_LATEST:-1}"
case "$PUSH_LATEST" in
  0|1) ;;
  *) echo "SYNC_PUSH_LATEST must be 0 or 1, not '${PUSH_LATEST}'" >&2; exit 2 ;;
esac

# Inputs are validated above, BEFORE the registry login: a refused build must have done nothing.
echo "$KAMAL_REGISTRY_PASSWORD" | docker login ghcr.io -u chaim354 --password-stdin

# THE UNRAID BOX IS amd64; THIS DEV MACHINE MAY NOT BE (Apple Silicon is arm64). A plain
# `docker build` tags and pushes an arm64 image just as happily as an amd64 one -- it does not
# fail here, it fails on the box as an exec-format error, far from this line. --platform forces
# the target explicitly; buildx cross-builds via QEMU emulation when the host arch differs.

# TWO TAGS, AND ONLY ONE OF THEM IS ALLOWED TO MOVE `:latest`.
#
# The revision tag carries the implementation -- `:<sha>-rust` -- because during the cutover a Ruby
# build and a Rust build of the SAME commit were two different images, and until the suffix they
# overwrote each other's `:<sha>` tag. The suffix stays now that only one implementation exists, so
# every tag pushed since then keeps meaning what it meant. And `:latest` is pushed only when
# SYNC_PUSH_LATEST is not `0` (validated above), because `:latest` is what the maker app's `sync`
# accessory pulls on its next `kamal accessory reboot sync`: a build that moves it ARMS that reboot
# (cutover plan §0.3.3). So:
#
#   SYNC_PUSH_LATEST=0 bin/build-and-push                             # :<sha>-rust; :latest untouched
#   docker buildx imagetools create -t $REPO:latest $REPO:<sha>-rust  # promote (cutover plan §4.2)
#
# The default is unchanged -- `:latest` moves, as it always has.
REVISION_IMAGE="$REPO:$REVISION-rust"
TAGS=(-t "$REVISION_IMAGE")
if [ "$PUSH_LATEST" = "1" ]; then
  TAGS+=(-t "$IMAGE")
fi

docker buildx build --platform linux/amd64 -f "$DOCKERFILE" \
  --label "org.opencontainers.image.revision=$REVISION" \
  --label "org.opencontainers.image.description=tinkerex-sync (rust)" \
  "${TAGS[@]}" --push .

echo "pushed $REVISION_IMAGE ($DOCKERFILE, revision $REVISION)"
if [ "$PUSH_LATEST" = "1" ]; then
  echo "pushed $IMAGE -> $REVISION_IMAGE"
else
  echo "left $IMAGE untouched (SYNC_PUSH_LATEST=0); promote with:"
  echo "  docker buildx imagetools create -t $IMAGE $REVISION_IMAGE"
fi
