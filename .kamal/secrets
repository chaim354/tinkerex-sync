# Kamal reads [secrets-common, secrets.<destination>]; this host has one destination, so everything
# lives here. Values are shell expansions ONLY -- this file is committed.
#
# SECRET_KEY_BASE rather than a RAILS_MASTER_KEY: this app ships no config/credentials.yml.enc and
# needs nothing from one. An API host with no credentials file is better served by the single value
# it actually uses than by a credentials store holding one key.
SECRET_KEY_BASE=$(bin/secret SECRET_KEY_BASE 'op://tinkerex/tinkerex-sync/secret key base')
KAMAL_REGISTRY_PASSWORD=$(bin/secret KAMAL_REGISTRY_PASSWORD 'op://tinkerex/ghcr.io/password')

# Only read when STORAGE_BACKEND=s3. Declared now so switching is a config change rather than a
# scramble; with STORAGE_BACKEND=local it is resolved and unused.
CHUNK_SECRET_ACCESS_KEY=$(bin/secret CHUNK_SECRET_ACCESS_KEY 'op://tinkerex/seaweednew/secret key')
