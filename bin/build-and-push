#!/usr/bin/env bash
# Build + push this repo's own image (./Dockerfile.rust, the Rust server, by default; SYNC_IMPL=ruby
# builds the Dockerfile at the root, host/ as the app) to ghcr, under a STABLE tag that exists
# independently of this repo's own `kamal deploy`.
#
# THAT DISTINCTION IS THE WHOLE REASON THIS SCRIPT EXISTS. config/deploy.yml here runs this app as
# ITS OWN kamal service (service: tinkerex-sync) and, when `kamal deploy` is actually run, tags the
# image by kamal's own per-deploy version (the git SHA kamal resolves internally) -- never
# `:latest`, and never on a schedule anyone but that command controls. A Kamal ACCESSORY (what the
# maker app, chaim354/tinkerex, would run this as, beside its own three LIBRARY_BACKEND
# deployments) never builds anything: `kamal accessory boot/reboot` only PULLS a named image, the
# same way it does today for the boxes/openscad sidecars and the addons bundle host. Until this
# script, nothing produced the tag that pull needs -- "nothing publishes an image of it" was true
# in exactly that sense, even though this repo's own standalone deploy had (separately) pushed
# SHA-versioned images under the same repository name.
#
# Mirrors chaim354/tinkerex's bin/build-boxes-sidecar / bin/build-openscad-sidecar: same registry,
# same 1Password item, same revision label. The TAGS differ -- the revision tag carries the
# implementation and `:latest` is optional (the tagging comment below). Run from THIS repo's root,
# same as those two.
#
# The ghcr token comes from 1Password via bin/secret -- no export needed. Export
# KAMAL_REGISTRY_PASSWORD first if you want to override it. `set -e` aborts here if the read fails
# (unlike kamal itself, whose backticks discard exit status -- see the maker app's
# bin/secrets-preflight and its CLAUDE.md §14g).
#
# The maker app's config/deploy.yml runs this image as its `sync` accessory, pulling `:latest`; the
# roll command from THAT repo is `bin/kamal accessory reboot sync`. Which is why `:latest` is the
# one tag this script must be able to leave alone (SYNC_PUSH_LATEST=0, below).
set -euo pipefail

KAMAL_REGISTRY_PASSWORD="$(bin/secret KAMAL_REGISTRY_PASSWORD 'op://tinkerex/ghcr.io/password')"
REPO="ghcr.io/chaim354/tinkerex-sync"
IMAGE="$REPO:latest"

# PROVENANCE -- the source commit rides inside the image as an OCI label, so a container already
# running can name the build it came from with no registry access and no tag enumeration:
#
#   docker inspect <container> --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
#
# A SHA TAG ALONE CANNOT ANSWER THAT (full argument in bin/build-boxes-sidecar over in the maker
# repo): the OCI distribution API has no digest->tag reverse lookup, and `kamal accessory details`
# shells out to `docker ps`, which prints the RUN REFERENCE -- `:latest` -- never a digest. The
# label rides inside the image itself, so it survives tag GC or a moved `:latest`; the
# `$REVISION-$SYNC_IMPL` tag below is registry inventory alongside it, not a substitute for it.
#
# DO NOT SPELL THIS `git describe --dirty`. `--dirty` only consults TRACKED files, and this
# Dockerfile's final stage does `COPY . .` from the working tree (build context = repo root, not a
# subdirectory -- the Gemfile at the root needs the gemspec and lib/tinkerex_sync/version.rb
# alongside it, and host/ needs the gem source next to it). An untracked file would build into the
# image while `--dirty` kept reporting a clean SHA. `git status --porcelain` lists untracked files
# too, so it is what decides -- same fix, same reasoning, as both sidecar scripts.
REVISION="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain)" ]; then
  REVISION="$REVISION-dirty"
fi

# WHICH IMPLEMENTATION: the Rust server (./Dockerfile.rust, THE DEFAULT) or the Ruby host
# (./Dockerfile, SYNC_IMPL=ruby). Same registry, same `:latest`, same revision label -- the
# accessory that pulls `:latest` cannot tell them apart, which is the whole cutover design
# (docs/superpowers/plans/2026-10-07-rust-cutover.md): retag to roll forward or back.
#
# RUST IS THE DEFAULT BECAUSE PRODUCTION RUNS IT: the `sync` accessory cut over on 2026-10-07, and
# this default followed on 2026-10-14. Until then a bare run built the RUBY image and moved
# `:latest`, so a bare run followed by `bin/kamal accessory reboot sync` rolled production back to
# Ruby, silently -- the readiness audit's footgun (the maker repo's
# docs/AUDIT-2026-10-12-readiness.md §2.4.2). A bare run can no longer do that. SYNC_IMPL=ruby
# exists only to rebuild the rollback image (cutover plan §6) until Phase 6 of
# docs/superpowers/plans/2026-09-30-rust-rewrite.md deletes it with the rest of the Ruby.
#
# Resolved ONCE, here, because `set -u` makes the bare `$SYNC_IMPL` in the label below an "unbound
# variable" exit -- AFTER `docker login` has already succeeded. The default (no SYNC_IMPL exported)
# build died there from the day the label was added until 2026-10-07; the label had only ever been
# built with SYNC_IMPL exported. test/build_and_push_test.rb drives the bare invocation.
SYNC_IMPL="${SYNC_IMPL:-rust}"
case "$SYNC_IMPL" in
  ruby) DOCKERFILE=Dockerfile ;;
  rust) DOCKERFILE=Dockerfile.rust ;;
  *) echo "SYNC_IMPL must be ruby or rust, not '${SYNC_IMPL}'" >&2; exit 2 ;;
esac

# `:latest` IS PUSHED ONLY WHEN SYNC_PUSH_LATEST IS 1 (unset = 1). Exactly `0` or `1`: anything else
# is refused rather than read as "yes", because a typo such as `SYNC_PUSH_LATEST=no` would otherwise
# move `:latest` -- the dangerous direction (the tagging comment below says why it is dangerous).
PUSH_LATEST="${SYNC_PUSH_LATEST:-1}"
case "$PUSH_LATEST" in
  0|1) ;;
  *) echo "SYNC_PUSH_LATEST must be 0 or 1, not '${PUSH_LATEST}'" >&2; exit 2 ;;
esac

# Inputs are validated above, BEFORE the registry login: a refused build must have done nothing.
echo "$KAMAL_REGISTRY_PASSWORD" | docker login ghcr.io -u chaim354 --password-stdin

# THE UNRAID BOX IS amd64; THIS DEV MACHINE MAY NOT BE (Apple Silicon is arm64). A plain
# `docker build` tags and pushes an arm64 image just as happily as an amd64 one -- it does not
# fail here, it fails on the box as an exec-format error, far from this line. --platform forces
# the target explicitly; buildx cross-builds via QEMU emulation when the host arch differs,
# matching config/deploy.yml's own `builder: arch: amd64` for this same app.

# TWO TAGS, AND ONLY ONE OF THEM IS ALLOWED TO MOVE `:latest`.
#
# The revision tag carries the implementation -- `:<sha>-ruby`, `:<sha>-rust` -- because a Ruby
# build and a Rust build of the SAME commit are two different images, and until this suffix they
# overwrote each other's `:<sha>` tag. And `:latest` is pushed only when SYNC_PUSH_LATEST is not
# `0` (validated above), because `:latest` is what the maker app's `sync` accessory pulls on its next
# `kamal accessory reboot sync`: with every build moving it, the Rust image could not be pushed for
# a rehearsal without also ARMING the next reboot to cut over (cutover plan §0.3.3). So:
#
#   SYNC_PUSH_LATEST=0 SYNC_IMPL=rust bin/build-and-push              # :<sha>-rust; :latest untouched
#   docker buildx imagetools create -t $REPO:latest $REPO:<sha>-rust  # promote (plan §4.2) -- and the
#                                                                      # rollback is the same command
#                                                                      # pointed at ruby-<R> (plan §6)
#
# The default is unchanged -- `:latest` moves, as it always has -- so existing use is untouched.
REVISION_IMAGE="$REPO:$REVISION-$SYNC_IMPL"
TAGS=(-t "$REVISION_IMAGE")
if [ "$PUSH_LATEST" = "1" ]; then
  TAGS+=(-t "$IMAGE")
fi

docker buildx build --platform linux/amd64 -f "$DOCKERFILE" \
  --label "org.opencontainers.image.revision=$REVISION" \
  --label "org.opencontainers.image.description=tinkerex-sync ($SYNC_IMPL)" \
  "${TAGS[@]}" --push .

echo "pushed $REVISION_IMAGE ($DOCKERFILE, revision $REVISION)"
if [ "$PUSH_LATEST" = "1" ]; then
  echo "pushed $IMAGE -> $REVISION_IMAGE"
else
  echo "left $IMAGE untouched (SYNC_PUSH_LATEST=0); promote with:"
  echo "  docker buildx imagetools create -t $IMAGE $REVISION_IMAGE"
fi
