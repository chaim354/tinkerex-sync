#!/usr/bin/env bash
# Resolve ONE secret and print it on stdout. This is the single definition of "where does a
# credential come from" for this repo — every .kamal/secrets* file, both sidecar builds, and
# bin/secrets-preflight go through here rather than each spelling out its own `op read`.
#
#   bin/secret VAR_NAME op://Vault/Item/field
#
# ORDER: an exported shell value WINS, then 1Password. The override is load-bearing, not a
# convenience — it is what lets a one-off deploy point at different storage (the OVH/R2 leg
# reuses the name CHUNK_SECRET_ACCESS_KEY for a *different* credential) without editing a
# tracked file, and it keeps every pre-existing `export FOO=… && kamal deploy` working.
#
# UNATTENDED RUNS NEED NO SECOND CODE PATH. `op read` uses OP_SERVICE_ACCOUNT_TOKEN when it is
# in the env and falls back to desktop-app/biometric auth when it is not — same command, so a
# self-hosted runner or a cron agent uses this file unmodified. That is the whole reason the
# service-account support here is a docs + preflight concern and not a branch.
#
# THE VALUE MUST NEVER REACH stderr, AND THE OBVIOUS WAY TO WRITE THAT IS BACKWARDS.
# `op read "$ref" 2>&1 >/dev/null` LEAKS THE SECRET: `2>&1` points fd2 at the *current* stdout
# (the captured pipe) and only then does `>/dev/null` move fd1, so the value lands in whatever
# captured the command. That printed a live ghcr PAT into an agent transcript on 2026-07-29 and
# the token had to be rotated. Here the value only ever travels on fd1 — captured by the
# caller's `$(…)` — while op's own diagnostics flow untouched to fd2. Never add a redirection
# that merges the two.
set -euo pipefail

name="${1:?usage: bin/secret VAR_NAME op://Vault/Item/field}"
ref="${2:?usage: bin/secret VAR_NAME op://Vault/Item/field}"

# 1. An exported shell value wins. Indirect expansion, so the caller names the variable once.
if [ -n "${!name:-}" ]; then
  printf '%s' "${!name}"
  exit 0
fi

# 2. Otherwise 1Password.
if ! command -v op >/dev/null 2>&1; then
  {
    echo "bin/secret: $name: 1Password CLI (op) is not installed, and \$$name is not exported."
    echo "            Either  brew install 1password-cli"
    echo "            or      export $name=… before running."
  } >&2
  exit 1
fi

if ! value="$(op read --no-newline "$ref")"; then
  {
    echo "bin/secret: $name: could not read $ref"
    echo "            Unlock the 1Password desktop app and retry. NOTE: \`op whoami\` reporting"
    echo "            'account is not signed in' is NOT the check — the desktop integration"
    echo "            authorizes per-read, so whoami fails on a perfectly usable vault. The only"
    echo "            valid readiness check is an \`op read\` exit code (bin/secrets-preflight)."
    echo "            For unattended runs, set OP_SERVICE_ACCOUNT_TOKEN instead."
  } >&2
  exit 1
fi

# An empty read is the dangerous case, not the loud one — see bin/secrets-preflight for why
# kamal cannot notice it on its own. Refuse here so at least a direct caller is told.
if [ -z "$value" ]; then
  {
    echo "bin/secret: $name: $ref resolved to an EMPTY value."
    echo "            The item exists but that field is blank or misnamed — check the field name"
    echo "            (1Password field labels are case- and space-sensitive: 'secret key')."
  } >&2
  exit 1
fi

printf '%s' "$value"
