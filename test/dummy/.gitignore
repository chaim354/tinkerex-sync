# Mirrors the host's own .gitignore (repo root) for the identical reason -- but that file's
# patterns (`/log/*`, `/tmp/*`, `/storage/*`) are ROOT-ANCHORED and so do not reach this nested
# Rails app at all; verified `git status` still offered test.sqlite3, test.log and the
# MemoryChunkStore's dev-chunks directory before this file existed.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
