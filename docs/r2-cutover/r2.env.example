# r2.env.example — environment for the R2 cutover tooling.
#
# Copy to r2.env, fill in the real values, then source it for the migration script:
#     cp r2.env.example r2.env
#     # edit r2.env
#     set -a; . ./r2.env; set +a
#     ./migrate-chunks.sh dry-run
#
# r2.env holds SECRETS — it is gitignored (see .gitignore in this dir). NEVER commit it.
# This .example file is committed and must contain only placeholders.

# --- SeaweedFS (current source store — what config/deploy.yml points at today) ---
SEAWEED_ENDPOINT=http://192.168.1.7:8333
SEAWEED_BUCKET=my-bucket
SEAWEED_ACCESS_KEY_ID=admin
SEAWEED_SECRET_ACCESS_KEY=CHANGE_ME_seaweed_secret
SEAWEED_REGION=us-east-1

# --- Cloudflare R2 (migration target) ---
# Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (Account ID: `wrangler whoami`
# or Cloudflare dashboard account home).
R2_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=maker-chunks-prod
# R2 API token (R2 -> Manage R2 API Tokens -> Object Read & Write, scoped to the bucket).
# Cloudflare shows the Access Key ID + Secret once on token creation.
R2_ACCESS_KEY_ID=CHANGE_ME_r2_access_key_id
R2_SECRET_ACCESS_KEY=CHANGE_ME_r2_secret_access_key
R2_REGION=auto

# --- Optional knobs ---
# NOTE: there is no CHUNK_PREFIX knob. The keyspace is "chunks/", hardcoded in
# Storage::ChunkStore#key_for with no ENV read, so migrate-chunks.sh hardcodes it too.
# RCLONE_TRANSFERS=32
# RCLONE_CHECKERS=64
